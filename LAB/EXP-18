
import math

def get_clusters():
    result = []

    for a in range(1, 6):
        for b in range(1, 6):
            value = a*a + a*b + b*b

            if value not in result:
                result.append(value)

    return sorted(result)[:10]


def get_values(N):
    ch = 336 // N
    D_R = math.sqrt(3 * N)
    SI = 10 * math.log10((D_R ** 4) / 6)
    cap = 21 * ch

    return ch, cap, D_R, SI


S = 336
M = 21
n = 4
required = 18

print("Total Channels:", S)
print("Number of Cells:", M)
print("Path Loss Exponent:", n)
print("Required S/I:", required, "dB")

print("\nN\tD/R\tChannels\tCapacity\tS/I(dB)\tResult")

best = 0

for N in get_clusters():

    channels, capacity, q, si = get_values(N)

    status = "Yes" if si >= required else "No"

    if si >= required and best == 0:
        best = N

    print(f"{N}\t{q:.2f}\t{channels}\t\t{capacity}\t\t{si:.2f}\t{status}")

print("\nMinimum Cluster Size N =", best)
